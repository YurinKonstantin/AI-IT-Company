<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_IT_Company.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Review_Title"
                   Text="Review (Apply / Reject)"
                   Style="{ThemeResource TitleTextBlockStyle}"/>

        <muxc:InfoBar Grid.Row="1"
                      IsOpen="{x:Bind ViewModel.AwaitingDecision, Mode=OneWay}"
                      IsClosable="False"
                      Severity="Warning"
                      Title="Pipeline paused"
                      Message="Apply or Reject changes to continue the run."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Apply selected"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ApplySelectedCommand}"/>
            <Button Content="Apply all"
                    Command="{x:Bind ViewModel.ApplyAllCommand}"/>
            <Button Content="Reject selected"
                    Command="{x:Bind ViewModel.RejectSelectedCommand}"/>
            <Button Content="Reject all"
                    Command="{x:Bind ViewModel.RejectAllCommand}"/>
            <Button Content="Open in editor"
                    Command="{x:Bind ViewModel.OpenInEditorCommand}"/>
            <Button Content="Clear"
                    Command="{x:Bind ViewModel.ClearHistoryCommand}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center" Opacity="0.8" Margin="12,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Padding="12" CornerRadius="8" Margin="0,0,0,4"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{x:Bind ViewModel.ShowTeachAfterReject, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Text="Teach from reject (optional)" FontWeight="SemiBold"/>
                <TextBox Header="What was wrong"
                         Text="{x:Bind ViewModel.RejectTeachWrong, Mode=TwoWay}"/>
                <TextBox Header="How it should be done"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                         Text="{x:Bind ViewModel.RejectTeachRight, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save lesson" Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveRejectTeachCommand}"/>
                    <Button Content="Skip" Command="{x:Bind ViewModel.SkipRejectTeachCommand}"/>
                    <TextBlock Text="{x:Bind ViewModel.RejectTeachStatus, Mode=OneWay}"
                               VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding RelativePath}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Opacity="0.6" FontSize="11"
                                           Text="{Binding Status}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Opacity="0.5" FontSize="11"
                                       Text="{Binding Source}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" Padding="10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer>
                    <TextBlock Text="{x:Bind ViewModel.DiffText, Mode=OneWay}"
                               FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
