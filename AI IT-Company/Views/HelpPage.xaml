<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_IT_Company.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AI_IT_Company.ViewModels"
    Loaded="Page_Loaded">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Справка" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Инструкция" Command="{x:Bind ViewModel.ShowGuideCommand}"/>
            <Button Content="Каталог функций" Command="{x:Bind ViewModel.ShowFeaturesCommand}"/>
            <TextBox Width="280" PlaceholderText="Поиск по заголовкам и тексту…"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderThickness="1" CornerRadius="8" Padding="4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView ItemsSource="{x:Bind ViewModel.Toc, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedToc, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpTocItem">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Padding="6,4"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" Padding="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{x:Bind ViewModel.BodyText, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="13"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                   Opacity="0.65" FontSize="12"/>
    </Grid>
</Page>
