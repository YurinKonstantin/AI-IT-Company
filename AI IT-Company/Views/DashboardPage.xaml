<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_IT_Company.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="Runs_Title" Text="Runs" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock x:Uid="Runs_Subtitle"
                       Text="Session history. Live progress is on the Agent page."
                       Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational"
                 Title="{x:Bind ViewModel.Runner.CurrentProjectId, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Runner.StatusText, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Uid="Runs_OpenAgent" Content="Open Agent"
                        Click="OpenAgent_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <Border Grid.Row="2" Style="{StaticResource SidePanelBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="Runs_History" Text="History" FontWeight="SemiBold" FontSize="16"/>
                    <Button x:Uid="Runs_Refresh" Content="Refresh"
                            Command="{x:Bind ViewModel.RefreshSessionsCommand}"/>
                    <TextBlock Text="{x:Bind ViewModel.SessionsStatus, Mode=OneWay}"
                               Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                          IsItemClickEnabled="True"
                          ItemClick="Sessions_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StartedAt}" Opacity="0.75" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Mode}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Opacity="0.7"/>
                                <TextBlock Grid.Column="3" Text="{Binding Prompt}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
