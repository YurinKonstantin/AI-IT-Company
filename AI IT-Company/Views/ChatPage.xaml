<Page x:Class="Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ComboBox Header="Режим" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
            <x:String>Создать новый</x:String>
            <x:String>Улучшить существующий</x:String>
            <x:String>Исправить ошибку</x:String>
            <x:String>Задокументировать</x:String>
        </ComboBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox PlaceholderText="Путь к проекту (для режима 2–4)"
               Width="500" Text="{x:Bind ViewModel.ProjectPath, Mode=TwoWay}"/>
            <Button Content="Обзор..." Command="{x:Bind ViewModel.PickFolderCommand}"/>
        </StackPanel>

        <TextBox Grid.Row="2" AcceptsReturn="True" MinHeight="120"
             PlaceholderText="Опишите задачу..."
             Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}"/>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="🚀 Запустить конвейер" Command="{x:Bind ViewModel.RunCommand}"/>
            <ScrollViewer Grid.Row="1">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Events}">
                    <DataTemplate>
                        <Border Padding="8" Margin="0,4" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Payload}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>