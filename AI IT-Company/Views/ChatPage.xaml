<Page x:Class="Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="💬 Чат с AI IT-Company"
                   Style="{ThemeResource TitleTextBlockStyle}"/>

        <!-- Режим -->
        <ComboBox Grid.Row="1"
                  Header="Режим работы"
                  MinWidth="280"
                  SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
            <x:String>Создать новый</x:String>
            <x:String>Улучшить существующий</x:String>
            <x:String>Исправить ошибку</x:String>
            <x:String>Задокументировать</x:String>
        </ComboBox>

        <!-- Путь к проекту -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox PlaceholderText="Путь к существующему проекту (для режимов 2–4)"
                     Width="520"
                     Text="{x:Bind ViewModel.ProjectPath, Mode=TwoWay}"/>
            <Button Content="📁 Обзор..." Command="{x:Bind ViewModel.PickFolderCommand}"/>
        </StackPanel>

        <!-- Ввод промпта -->
        <TextBox Grid.Row="3"
                 AcceptsReturn="True"
                 MinHeight="120"
                 Header="Задача"
                 PlaceholderText="Опишите, что нужно сделать..."
                 Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}"/>

        <!-- Панель управления запуском + текущий проект -->
        <!-- Панель управления запуском + текущий проект -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
            Content="🚀 Запустить конвейер"
            Style="{ThemeResource AccentButtonStyle}"
            Command="{x:Bind ViewModel.RunCommand}"
            IsEnabled="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay,
                        Converter={StaticResource BoolNegationConverter}}"/>

            <Button Grid.Column="1"
            Content="⏹ Остановить"
            Command="{x:Bind ViewModel.StopCommand}"
            IsEnabled="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay}"/>

            <muxc:ProgressRing Grid.Column="2"
                       IsActive="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay}"
                       Width="24" Height="24" VerticalAlignment="Center"/>

            <muxc:InfoBar Grid.Column="3"
                  IsOpen="{x:Bind ViewModel.Runner.HasActiveProject, Mode=OneWay}"
                  IsClosable="False" Severity="Success" Title="Проект">
                <muxc:InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                        <TextBlock Text="ID:" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentProjectId, Mode=OneWay}"
                           FontFamily="Consolas" FontWeight="SemiBold"/>
                        <Button Content="📋" ToolTipService.ToolTip="Скопировать ID"
                        Command="{x:Bind ViewModel.CopyProjectIdCommand}" Padding="6,2"/>
                        <TextBlock Text="→" Opacity="0.5"/>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentOutputRoot, Mode=OneWay}"
                           FontFamily="Consolas" Opacity="0.85"
                           TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>
                </muxc:InfoBar.Content>
                <muxc:InfoBar.ActionButton>
                    <Button Content="📂 Открыть папку" Command="{x:Bind ViewModel.OpenFolderCommand}"/>
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>
        </Grid>

        <!-- Лента событий (теперь показывает Icon + Role + Payload) -->
        <Border Grid.Row="5" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Runner.Events, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <DataTemplate>
                        <Border Padding="10" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Icon}" FontSize="16"/>
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding At}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Payload}" TextWrapping="Wrap"
                                   Opacity="0.85" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>