<Page x:Class="Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:vm="using:ViewModels"
      KeyDown="Page_KeyDown">

    <Grid Padding="12" ColumnSpacing="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="Agent_Title" Text="Studio" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock x:Uid="Studio_Banner"
                           Text="Studio — describe an idea; agents implement. Review Apply/Reject when asked."
                           Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.Runner.StatusText, Mode=OneWay}"
                           Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Uid="Agent_ClearTimeline" Content="Clear"
                        Command="{x:Bind ViewModel.ClearTimelineCommand}"/>
                <Button Content="☰"
                        ToolTipService.ToolTip="Side panel"
                        Command="{x:Bind ViewModel.ToggleSidePanelCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Gate banners (visible even if side panel closed) -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.Runner.AwaitingChangeReview, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Pipeline paused — Review" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.9">
                            <Run Text="Pending changes: "/>
                            <Run Text="{x:Bind ViewModel.Runner.PendingChangesCount, Mode=OneWay}"/>
                            <Run Text=". Apply or Reject to continue."/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open Review"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenReviewCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.Runner.AwaitingBuildFixDecision, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Agent_BuildFix_Title" Text="Build not fixed" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.Runner.BuildFixPrompt, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                    <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11" MaxHeight="120"
                             Visibility="{x:Bind ViewModel.HasBuildFixLog, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Runner.BuildFixLogSnippet, Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Agent_BuildFix_Rollback" Content="Rollback"
                                Command="{x:Bind ViewModel.BuildFixRollbackCommand}"/>
                        <Button x:Uid="Agent_BuildFix_Continue" Content="Fixed — continue"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.BuildFixManualContinueCommand}"/>
                        <Button x:Uid="Agent_BuildFix_Proceed" Content="Continue with error"
                                Command="{x:Bind ViewModel.BuildFixProceedWithErrorCommand}"/>
                        <Button x:Uid="Agent_OpenFolder" Content="Folder"
                                Command="{x:Bind ViewModel.OpenFolderCommand}"/>
                        <Button Content="Open editor"
                                Command="{x:Bind ViewModel.OpenProjectInEditorCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Timeline -->
        <Border Grid.Row="2"
                Style="{StaticResource SidePanelBorderStyle}"
                Padding="8">
            <ScrollViewer x:Name="TimelineScroll"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineItemVm">
                            <Border Padding="12,10" CornerRadius="12" Margin="0,0,48,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind At}" Opacity="0.45" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap"
                                               Opacity="0.9" IsTextSelectionEnabled="True"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>

        <!-- Side panel -->
        <Border Grid.Row="2" Grid.Column="1"
                Style="{StaticResource SidePanelBorderStyle}"
                Width="{StaticResource AppSidePanelWidth}"
                Visibility="{x:Bind ViewModel.IsSidePanelOpen, Mode=OneWay}">
            <ScrollViewer>
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="Agent_Side_Run" Text="Run" FontWeight="SemiBold" FontSize="16"/>

                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.Runner.HasActiveProject, Mode=OneWay}">
                        <TextBlock Opacity="0.65" FontSize="12" Text="Project"/>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentProjectId, Mode=OneWay}"
                                   FontFamily="Consolas" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentOutputRoot, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11" Opacity="0.75"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Uid="Agent_OpenFolder" Content="Folder"
                                    Command="{x:Bind ViewModel.OpenFolderCommand}"/>
                            <Button Content="ID" Command="{x:Bind ViewModel.CopyProjectIdCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Opacity="0.65" FontSize="12" x:Uid="Agent_Side_Progress" Text="Progress"/>
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{x:Bind ViewModel.Runner.ProgressPercent, Mode=OneWay}"/>
                        <TextBlock>
                            <Run Text="{x:Bind ViewModel.Runner.CompletedStages, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{x:Bind ViewModel.Runner.TotalStages, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{x:Bind ViewModel.Runner.ProgressPercent, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentAgent, Mode=OneWay}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentModel, Mode=OneWay}"
                                   Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.Runner.CurrentStage, Mode=OneWay}"
                                   Opacity="0.8" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Uid="Agent_RetryStage" Content="Retry stage"
                            Command="{x:Bind ViewModel.RetryFailedStageCommand}"
                            IsEnabled="{x:Bind ViewModel.Runner.CanRetryLastFailedStage, Mode=OneWay}"/>

                    <Border Padding="10" CornerRadius="8"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{x:Bind ViewModel.Runner.AwaitingBuildFixDecision, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Agent_BuildFix_Title" Text="Build not fixed"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.Runner.BuildFixPrompt, Mode=OneWay}"
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.85"/>
                            <Button x:Uid="Agent_BuildFix_Rollback" Content="Rollback"
                                    Command="{x:Bind ViewModel.BuildFixRollbackCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <Button x:Uid="Agent_BuildFix_Continue" Content="Fixed — continue"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.BuildFixManualContinueCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <Button x:Uid="Agent_BuildFix_Proceed" Content="Continue with error"
                                    Command="{x:Bind ViewModel.BuildFixProceedWithErrorCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.OpenReviewCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="Agent_OpenReview" Text="Review changes"/>
                            <TextBlock Text="{x:Bind ViewModel.Runner.PendingChangesCount, Mode=OneWay}"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Border Padding="10" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Teach" FontWeight="SemiBold"/>
                                <TextBlock Opacity="0.65" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="lessons:"/>
                                    <Run Text="{x:Bind ViewModel.EnabledLessonCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Header="Role"
                                      ItemsSource="{x:Bind ViewModel.TeachRoleOptions}"
                                      SelectedIndex="{x:Bind ViewModel.TeachRoleIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBox Header="What was wrong"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                     Text="{x:Bind ViewModel.TeachWrong, Mode=TwoWay}"/>
                            <TextBox Header="How to do it correctly"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                     Text="{x:Bind ViewModel.TeachRight, Mode=TwoWay}"/>
                            <Button Content="Save lesson"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SaveTeachLessonCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{x:Bind ViewModel.TeachStatus, Mode=OneWay}"
                                       Opacity="0.8" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ComposerBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Uid="Agent_Mode" Header=""
                              MinWidth="140"
                              ItemsSource="{x:Bind ViewModel.ModeOptions}"
                              SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.ModeHint, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.ModeHint, Mode=OneWay}"
                               Opacity="0.65" TextWrapping="Wrap" MaxWidth="420"
                               VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="8"
                      Visibility="{x:Bind ViewModel.NeedsProjectFolder, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="Agent_ProjectPath"
                             PlaceholderText="Project folder"
                             Text="{x:Bind ViewModel.ProjectPath, Mode=TwoWay}"/>
                    <Button Grid.Column="1" x:Uid="Agent_Browse" Content="Browse…"
                            Command="{x:Bind ViewModel.PickFolderCommand}"/>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="@file" Command="{x:Bind ViewModel.AttachFileCommand}"/>
                        <Button Content="@folder" Command="{x:Bind ViewModel.AttachFolderCommand}"/>
                        <Button x:Uid="Agent_ClearAttach" Content="Clear"
                                Command="{x:Bind ViewModel.ClearAttachmentsCommand}"/>
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="6"/>
                        </ItemsRepeater.Layout>
                        <DataTemplate x:DataType="vm:ContextChipVm">
                            <Border Padding="8,4" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Label}" FontFamily="Consolas" FontSize="12"
                                               ToolTipService.ToolTip="{x:Bind Path}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox"
                             x:Uid="Agent_Prompt"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72" MaxHeight="160"
                             PlaceholderText="Describe the task…  (@file path / @folder path)"
                             Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}"/>
                    <Button Grid.Column="1"
                            x:Uid="Agent_Send"
                            Content="Send"
                            Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="88"
                            Command="{x:Bind ViewModel.RunCommand}"
                            IsEnabled="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                    <Button Grid.Column="2"
                            x:Uid="Agent_Stop"
                            Content="Stop"
                            Command="{x:Bind ViewModel.StopCommand}"
                            IsEnabled="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
