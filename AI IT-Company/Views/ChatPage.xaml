<Page x:Class="Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💬 Чат с AI IT-Company"
                   Style="{ThemeResource TitleTextBlockStyle}"/>

        <StackPanel Grid.Row="1" Spacing="6">
            <ComboBox Header="Режим работы"
                      MinWidth="360"
                      ToolTipService.ToolTip="{x:Bind ViewModel.ModeHint, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                <x:String>Авто (определит Interpreter)</x:String>
                <x:String>Создать новый</x:String>
                <x:String>Улучшить существующий</x:String>
                <x:String>Исправить ошибку</x:String>
                <x:String>Задокументировать</x:String>
                <x:String>Проанализировать</x:String>
                <x:String>Только ТЗ / архитектура</x:String>
            </ComboBox>
            <TextBlock Text="{x:Bind ViewModel.ModeHint, Mode=OneWay}"
                       Opacity="0.75" TextWrapping="Wrap"/>
            <muxc:InfoBar IsOpen="{x:Bind ViewModel.NeedsProjectFolder, Mode=OneWay}"
                          Severity="Informational"
                          IsClosable="False"
                          Title="Нужна папка проекта"
                          Message="Укажите путь ниже (Обзор…) — без папки режим Improve / Fix / Document / Analyze не стартует."/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox PlaceholderText="Путь к проекту (нужен для Improve / Fix / Document / Analyze; в Авто — если задача про существующий код)"
                     Width="520"
                     Text="{x:Bind ViewModel.ProjectPath, Mode=TwoWay}"/>
            <Button Content="📁 Обзор..." Command="{x:Bind ViewModel.PickFolderCommand}"/>
        </StackPanel>

        <!-- @file / @folder -->
        <StackPanel Grid.Row="3" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Контекст" VerticalAlignment="Center" Opacity="0.8"/>
                <Button Content="@file" Command="{x:Bind ViewModel.AttachFileCommand}"/>
                <Button Content="@folder" Command="{x:Bind ViewModel.AttachFolderCommand}"/>
                <Button Content="Очистить" Command="{x:Bind ViewModel.ClearAttachmentsCommand}"/>
                <TextBlock Opacity="0.55" VerticalAlignment="Center"
                           Text="или в тексте: @file path · @folder path"/>
            </StackPanel>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6"/>
                </ItemsRepeater.Layout>
                <DataTemplate>
                    <Border Padding="8,4" CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"
                                   ToolTipService.ToolTip="{Binding Path}"/>
                    </Border>
                </DataTemplate>
            </ItemsRepeater>
        </StackPanel>

        <TextBox Grid.Row="4"
                 AcceptsReturn="True"
                 MinHeight="110"
                 Header="Задача"
                 PlaceholderText="Опишите, что нужно сделать... Можно @file D:\proj\App.xaml"
                 Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}"/>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
            Content="🚀 Запустить конвейер"
            Style="{ThemeResource AccentButtonStyle}"
            Command="{x:Bind ViewModel.RunCommand}"
            IsEnabled="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay,
                        Converter={StaticResource BoolNegationConverter}}"/>

            <Button Grid.Column="1"
            Content="⏹ Остановить"
            Command="{x:Bind ViewModel.StopCommand}"
            IsEnabled="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay}"/>

            <muxc:ProgressRing Grid.Column="2"
                       IsActive="{x:Bind ViewModel.Runner.IsRunning, Mode=OneWay}"
                       Width="24" Height="24" VerticalAlignment="Center"/>

            <muxc:InfoBar Grid.Column="3"
                  IsOpen="{x:Bind ViewModel.Runner.HasActiveProject, Mode=OneWay}"
                  IsClosable="False" Severity="Success" Title="Проект">
                <muxc:InfoBar.Content>
                    <StackPanel Spacing="4" Margin="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="ID:" Opacity="0.7"/>
                            <TextBlock Text="{x:Bind ViewModel.Runner.CurrentProjectId, Mode=OneWay}"
                               FontFamily="Consolas" FontWeight="SemiBold"/>
                            <Button Content="📋" ToolTipService.ToolTip="Скопировать ID"
                            Command="{x:Bind ViewModel.CopyProjectIdCommand}" Padding="6,2"/>
                            <TextBlock Text="→" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.Runner.CurrentOutputRoot, Mode=OneWay}"
                               FontFamily="Consolas" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Runner.StatusText, Mode=OneWay}"
                                       Opacity="0.9" TextWrapping="Wrap"/>
                            <Button Content="🔁 Повторить этап"
                                    Command="{x:Bind ViewModel.RetryFailedStageCommand}"
                                    IsEnabled="{x:Bind ViewModel.Runner.CanRetryLastFailedStage, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </muxc:InfoBar.Content>
                <muxc:InfoBar.ActionButton>
                    <Button Content="📂 Открыть папку" Command="{x:Bind ViewModel.OpenFolderCommand}"/>
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>
        </Grid>

        <Border Grid.Row="6" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Runner.Events, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <DataTemplate>
                        <Border Padding="10" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Icon}" FontSize="16"/>
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding At}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Payload}" TextWrapping="Wrap"
                                   Opacity="0.85" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
