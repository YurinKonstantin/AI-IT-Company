<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_IT_Company.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AI_IT_Company.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="using:AI_IT_Company.ViewModels"
    mc:Ignorable="d"
     x:Name="RootPage" >

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статус -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="📥 Модели Ollama" Style="{ThemeResource TitleTextBlockStyle}"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                               Width="24" Height="24" VerticalAlignment="Center"/>
        </StackPanel>

        <InfoBar Grid.Row="1"
                      IsOpen="True"
                      IsClosable="False"
                      Message="{x:Bind ViewModel.StatusText, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="🔄 Обновить" Command="{x:Bind ViewModel.RefreshCommand}"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Секция загрузки -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="Скачать модель" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox PlaceholderText="напр. qwen2.5-coder:7b"
                             Width="360"
                             Text="{x:Bind ViewModel.PullModelName, Mode=TwoWay}"/>
                    <Button Content="⬇ Скачать"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.PullCommand}"
                            IsEnabled="{x:Bind ViewModel.IsOllamaAvailable, Mode=OneWay}"/>
                    <Button Content="⏹ Отменить"
                            Command="{x:Bind ViewModel.CancelPullCommand}"
                            IsEnabled="{x:Bind ViewModel.IsPulling, Mode=OneWay}"/>
                </StackPanel>

                <!-- Популярные -->
                <TextBlock Text="Быстрый выбор:" Opacity="0.7"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Suggested}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <DataTemplate x:DataType="viewmodels:SuggestedModel">
                        <Button Padding="10,6"
                                Command="{Binding ElementName=RootPage, Path=ViewModel.PickSuggestedCommand}"
                                CommandParameter="{x:Bind}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.75"/>
                                <TextBlock Text="{x:Bind ApproxSize}"  FontSize="11" Opacity="0.55"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater>

                <!-- Прогресс -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.IsPulling, Mode=OneWay}">
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.PullProgress, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.PullStatus, Mode=OneWay}" Opacity="0.85"/>
                </StackPanel>

                <!--<TextBlock Text="{x:Bind ViewModel.PullStatus, Mode=OneWay}" x:Name="MyHiddenTextBlock"
                           Opacity="0.7"
                           Visibility="{x:Bind ViewModel.IsPulling, Mode=OneWay, Converter={StaticResource InvertVis}}"
                           x:Load="False"/>-->
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Установленные модели" FontWeight="SemiBold"/>

        <!-- Список установленных -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.InstalledModels}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="8"/>
                </ItemsRepeater.Layout>
                <DataTemplate x:DataType="viewmodels:ModelItem">
                    <Border Padding="12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" Opacity="0.75">
                                    <TextBlock Text="{x:Bind SizeText}"/>
                                    <TextBlock Text="{x:Bind ParameterSize}"/>
                                    <TextBlock Text="{x:Bind Quantization}"/>
                                    <TextBlock Text="{x:Bind Family}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ModifiedText}" FontSize="11" Opacity="0.55"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="🗑 Удалить"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteCommand}"
                                    CommandParameter="{x:Bind}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
