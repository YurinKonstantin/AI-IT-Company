<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_IT_Company.Views.FreelancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" RowSpacing="10" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Биржа (фриланс + GitHub bounties)"
                   Style="{ThemeResource TitleTextBlockStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="🔎 Охота"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.HuntCommand}"
                    IsEnabled="{x:Bind ViewModel.IsHunting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
            <Button Content="🔄 Обновить" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <Button Content="✅ Принять" Command="{x:Bind ViewModel.AcceptCommand}"/>
            <Button Content="⏭ Пропустить" Command="{x:Bind ViewModel.SkipCommand}"/>
            <Button Content="🌐 На бирже" Command="{x:Bind ViewModel.OpenOnMarketplaceCommand}"/>
            <Button Content="📂 Результат" Command="{x:Bind ViewModel.OpenOutputCommand}"/>
            <muxc:ProgressRing IsActive="{x:Bind ViewModel.IsHunting, Mode=OneWay}" Width="22" Height="22"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center" Opacity="0.85" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Stats dashboard -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Статистика" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.StatsSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.SimulationHint, Mode=OneWay}"
                               Foreground="Orange" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Топ тегов / bias" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopTagsLines, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Opacity="0.85"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Audit" FontWeight="SemiBold"/>
                    <ScrollViewer MaxHeight="90">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AuditLines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.45*"/>
            </Grid.RowDefinitions>

            <Border BorderThickness="1" CornerRadius="8" Padding="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Лента офферов" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListView ItemsSource="{x:Bind ViewModel.Feed, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                              Height="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="2">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SummaryLine}" Opacity="0.75" FontSize="12"/>
                                    <TextBlock Text="{Binding Budget}" Opacity="0.6" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" Padding="10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Почему score (explainability)" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}" TextWrapping="Wrap" FontSize="16"/>
                        <TextBlock Text="{x:Bind ViewModel.Selected.SummaryLine, Mode=OneWay}" Opacity="0.8"/>
                        <TextBlock Text="{x:Bind ViewModel.Selected.Tags, Mode=OneWay}" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.Selected.Explain, Mode=OneWay}"
                                   FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="{x:Bind ViewModel.HuntLog, Mode=OneWay}"
                                   Opacity="0.65" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Активные / на оценке" FontWeight="SemiBold" Margin="0,8,0,4"/>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListView ItemsSource="{x:Bind ViewModel.Active, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.ReviewQueue, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="4" BorderThickness="1" CornerRadius="8" Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Оценка внутреннего выполнения (учит калибровку скоринга)" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Успех" IsChecked="{x:Bind ViewModel.ReviewSuccess, Mode=TwoWay}"/>
                    <Slider Header="Оценка 1–5" Minimum="1" Maximum="5" StepFrequency="1"
                            Width="220" Value="{x:Bind ViewModel.ReviewRating, Mode=TwoWay}"/>
                    <TextBox Header="Комментарий" Width="320"
                             Text="{x:Bind ViewModel.ReviewNotes, Mode=TwoWay}"/>
                    <Button Content="💾 Сохранить оценку"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SubmitReviewCommand}"
                            VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
