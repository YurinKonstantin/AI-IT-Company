<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AI_IT_Company.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AI_IT_Company"
    xmlns:converters="using:AI_IT_Company.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Design tokens -->
            <x:Double x:Key="AppSpaceSm">8</x:Double>
            <x:Double x:Key="AppSpaceMd">12</x:Double>
            <x:Double x:Key="AppSpaceLg">16</x:Double>
            <x:Double x:Key="AppSpaceXl">24</x:Double>
            <CornerRadius x:Key="AppCardCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="AppBubbleCornerRadius">12</CornerRadius>
            <x:Double x:Key="AppSidePanelWidth">300</x:Double>

            <Style x:Key="TimelineBubbleBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource AppBubbleCornerRadius}"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="UserBubbleStyle" TargetType="Border" BasedOn="{StaticResource TimelineBubbleBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Style>

            <Style x:Key="AgentBubbleStyle" TargetType="Border" BasedOn="{StaticResource TimelineBubbleBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <Style x:Key="SystemBubbleStyle" TargetType="Border" BasedOn="{StaticResource TimelineBubbleBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            </Style>

            <Style x:Key="ComposerBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            </Style>

            <Style x:Key="SidePanelBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
